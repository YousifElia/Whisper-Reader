/**
 * Will Kokoro actually work on this machine?
 *
 * Two things have to be true, and they are independent:
 *
 *   1. It has to be FAST ENOUGH. Realtime factor below ~0.6 means synthesis
 *      outruns playback and the sentence-lookahead scheduler never starves.
 *   2. It has to be CORRECT. A backend can be fast precisely because it is
 *      computing garbage -- on the machine this was developed against, fp16
 *      on WebGPU returned 100% NaN at a very flattering 0.32 realtime factor.
 *      Timing alone would have shipped silence.
 *
 * So every configuration is checked for both, and the audio is kept so it can
 * be listened to rather than merely measured.
 *
 * This also reproduces the extension's constraints: the ONNX runtime is served
 * from a local path, because MV3 forbids remotely-hosted code.
 */

import { KokoroTTS } from 'kokoro-js';
import { env } from '@huggingface/transformers';

export const MODEL_ID = 'onnx-community/Kokoro-82M-v1.0-ONNX';

/** The four voices this project ships. Grades are the model authors' own. */
export const VOICES = [
  { id: 'af_heart', label: 'Heart', grade: 'A' },
  { id: 'af_bella', label: 'Bella', grade: 'A-' },
  { id: 'am_echo', label: 'Echo', grade: 'D' },
  { id: 'am_liam', label: 'Liam', grade: 'D' },
] as const;

/**
 * transformers.js validates dtype against a closed list -- auto, fp32, fp16,
 * q8, int8, uint8, q4, bnb4, q4f16 -- so model_q8f16.onnx (86 MB) cannot be
 * requested through its API at all.
 */
export const DTYPE_SIZES: Record<string, string> = {
  q8: '92 MB',
  fp16: '163 MB',
  fp32: '326 MB',
  q4: '305 MB',
  q4f16: '155 MB',
};

export interface AudioCheck {
  samples: number;
  seconds: number;
  nanPercent: number;
  peak: number;
  rms: number;
  /** Non-finite output, or near-silence, means the backend is broken. */
  valid: boolean;
}

export interface ConfigResult {
  dtype: string;
  device: string;
  threads: number;
  loadMs: number;
  synthMs: number;
  realtimeFactor: number;
  audio: AudioCheck;
  verdict: 'usable' | 'too slow' | 'BROKEN output' | 'failed';
  error?: string;
}

let tts: KokoroTTS | null = null;
let lastAudio: { data: Float32Array; rate: number } | null = null;

function configureRuntime(wasmPath: string): void {
  env.backends.onnx.wasm.wasmPaths = wasmPath;

  // Without this ORT takes navigator.gpu's default adapter, which on a machine
  // with switchable graphics can be the weak integrated one.
  const webgpu = (env.backends.onnx as { webgpu?: Record<string, unknown> })
    .webgpu;
  if (webgpu) webgpu.powerPreference = 'high-performance';

  // WASM threading needs SharedArrayBuffer, which needs cross-origin
  // isolation. Requesting threads without it makes ORT fail to spawn workers.
  const isolated =
    typeof SharedArrayBuffer !== 'undefined' && globalThis.crossOriginIsolated;
  env.backends.onnx.wasm.numThreads = isolated
    ? Math.min(navigator.hardwareConcurrency || 4, 8)
    : 1;
}

export function checkAudio(data: Float32Array, rate: number): AudioCheck {
  let nan = 0;
  let peak = 0;
  let sumSquares = 0;

  for (let i = 0; i < data.length; i++) {
    const x = data[i]!;
    if (!Number.isFinite(x)) {
      nan++;
      continue;
    }
    const magnitude = Math.abs(x);
    if (magnitude > peak) peak = magnitude;
    sumSquares += x * x;
  }

  const finite = data.length - nan;
  const rms = finite > 0 ? Math.sqrt(sumSquares / finite) : 0;

  return {
    samples: data.length,
    seconds: Number((data.length / rate).toFixed(2)),
    nanPercent: Number(((100 * nan) / Math.max(data.length, 1)).toFixed(1)),
    peak: Number(peak.toFixed(4)),
    rms: Number(rms.toFixed(4)),
    // Speech should peak well clear of the noise floor. A silent or
    // non-finite buffer is a broken backend, not a quiet voice.
    valid: nan === 0 && peak > 0.02 && rms > 0.002,
  };
}

export async function testConfig(
  dtype: string,
  device: 'wasm' | 'webgpu',
  voice: string = 'af_heart',
  wasmPath = '/ort/',
  onProgress?: (info: unknown) => void,
): Promise<ConfigResult> {
  configureRuntime(wasmPath);

  const base: ConfigResult = {
    dtype,
    device,
    threads: env.backends.onnx.wasm.numThreads as number,
    loadMs: 0,
    synthMs: 0,
    realtimeFactor: 0,
    audio: {
      samples: 0,
      seconds: 0,
      nanPercent: 0,
      peak: 0,
      rms: 0,
      valid: false,
    },
    verdict: 'failed',
  };

  try {
    const loadStart = performance.now();
    tts = await KokoroTTS.from_pretrained(MODEL_ID, {
      dtype: dtype as 'q8',
      device,
      progress_callback: onProgress as never,
    });
    base.loadMs = Math.round(performance.now() - loadStart);

    // First inference includes shader/kernel compilation; it is a one-off and
    // would badly misrepresent the steady state.
    await tts.generate('Warming up.', { voice: voice as 'af_heart' });

    const sentence =
      'Water boils at one hundred degrees, and yet the kettle takes its time.';
    const synthStart = performance.now();
    const raw = await tts.generate(sentence, { voice: voice as 'af_heart' });
    base.synthMs = Math.round(performance.now() - synthStart);

    const data = raw.audio as Float32Array;
    const rate = raw.sampling_rate;
    lastAudio = { data, rate };

    base.audio = checkAudio(data, rate);
    base.realtimeFactor = Number(
      (base.synthMs / 1000 / Math.max(base.audio.seconds, 0.01)).toFixed(3),
    );

    base.verdict = !base.audio.valid
      ? 'BROKEN output'
      : base.realtimeFactor < 0.6
        ? 'usable'
        : 'too slow';
  } catch (error) {
    base.error = String((error as Error)?.message ?? error).slice(0, 300);
    base.verdict = 'failed';
  }

  return base;
}

/** Play whatever was generated last, so it can be judged by ear. */
export async function playLast(): Promise<string> {
  if (!lastAudio) return 'nothing generated yet';
  const { data, rate } = lastAudio;
  if (!Number.isFinite(data[Math.floor(data.length / 2)] ?? NaN)) {
    return 'refusing to play: buffer is not finite';
  }

  const ctx = new AudioContext({ sampleRate: rate });
  const buffer = ctx.createBuffer(1, data.length, rate);
  buffer.copyToChannel(data, 0);
  const source = ctx.createBufferSource();
  source.buffer = buffer;
  source.connect(ctx.destination);
  source.start();
  await new Promise((resolve) => {
    source.onended = resolve;
  });
  await ctx.close();
  return 'played';
}

export async function speak(text: string, voice: string): Promise<AudioCheck> {
  if (!tts) throw new Error('Load a configuration first');
  const raw = await tts.generate(text, { voice: voice as 'af_heart' });
  const data = raw.audio as Float32Array;
  lastAudio = { data, rate: raw.sampling_rate };
  return checkAudio(data, raw.sampling_rate);
}

export async function environment(): Promise<Record<string, unknown>> {
  let adapter: unknown = null;
  try {
    const a = await navigator.gpu?.requestAdapter({
      powerPreference: 'high-performance',
    });
    adapter = a
      ? {
          vendor: a.info?.vendor ?? '(unreported)',
          architecture: a.info?.architecture ?? '(unreported)',
          isFallback: a.isFallbackAdapter ?? null,
        }
      : 'no adapter';
  } catch (error) {
    adapter = `error: ${(error as Error).message}`;
  }

  return {
    webgpu: 'gpu' in navigator,
    adapter,
    crossOriginIsolated: globalThis.crossOriginIsolated,
    sharedArrayBuffer: typeof SharedArrayBuffer !== 'undefined',
    cores: navigator.hardwareConcurrency,
    memoryGB: (navigator as { deviceMemory?: number }).deviceMemory ?? null,
  };
}

Object.assign(globalThis, {
  __kokoro: {
    testConfig,
    playLast,
    speak,
    environment,
    checkAudio,
    VOICES,
    DTYPE_SIZES,
  },
});
