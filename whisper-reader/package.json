{
  "name": "whisper-reader",
  "version": "0.1.0",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness:build": "vite build -c tests/harness/vite.config.ts && vite build -c tests/harness/vite.demo.config.ts",
    "harness:real": "npm run harness:build && node tests/harness/real-pages.mjs",
    "harness:serve": "node tests/harness/serve.mjs",
    "postinstall": "wxt prepare",
    "check:reproducible": "node scripts/check-reproducible.mjs firefox",
    "media": "node scripts/media/capture.mjs"
  },
  "devDependencies": {
    "@wxt-dev/module-svelte": "^2.0.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Reads the page aloud in a calm voice and highlights the words as it goes.",
  "repository": {
    "type": "git",
    "url": ""
  }
}
